rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Patron Profiles
    match /patrons/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && incoming().uid == request.auth.uid;
      allow delete: if false;
    }

    // Salon Appointments
    match /appointments/{appointmentId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Vault Pieces
    match /vaultPieces/{pieceId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Encrypted Concierge Messages
    match /encryptedMessages/{messageId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Patron Inscriptions
    match /inscriptions/{inscriptionId} {
      allow get, list: if isSignedIn();
      allow create: if incoming().honorificName is string && incoming().contactEmail is string;
      allow update, delete: if false;
    }
  }
}
